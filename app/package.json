    "react-router-dom": "^6.28.0",
    "jspdf": "latest",
    "jspdf-autotable": "latest",
    "pptxgenjs": "latest",
    "@capacitor/core": "8.5.3",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
